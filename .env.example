# Hardware selector: jetson | rpi
MODEL_DEVICE=jetson

# PyTorch inference: auto | cuda | cpu. Jetson production uses cuda.
TORCH_DEVICE=cuda
CUDA_DEVICE_INDEX=0
CUDA_EMPTY_CACHE_AFTER_ANALYSIS=0

# RPi ONNX model paths (used when MODEL_DEVICE=rpi)
MEDIAPIPE_ONNX_PATH=models/yolo.onnx
CLASSIFIER_ONNX_PATH=models/efficientnet.onnx

# Server config
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG_MODE=0
SESSION_COOKIE_SECURE=0
EYE_APP_SECRET_KEY=

# Required persistent identifier hashing secret. Never change after user data exists.
HASH_PEPPER=

# Admin auth (required for /api/admin/login)
ADMIN_LOGIN_NAME=admin
ADMIN_LOGIN_PASSWORD=
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=300
ADMIN_LOGIN_LOCK_SECONDS=300

# Camera / thresholds (optional overrides for config.py)
# Eye and skin use the regular webcam. Scalp uses the USB microscope.
CAMERA_DEVICE_INDEX=0
MICROSCOPE_CAMERA_DEVICE_INDEX=1
MEDIAPIPE_CONF_THRESHOLD=0.5
MEDIAPIPE_IOU_THRESHOLD=0.45
MEDIAPIPE_STATUS_CONF_THRESHOLD=0.25
MEDIAPIPE_INPUT_SIZE=640
CLASSIFIER_CONFIDENCE_THRESHOLD=0.7
IRIS_REMOVAL_ENABLED=1
IRIS_THRESHOLD=0.3
AUTO_DIST_THRESHOLD=30
AUTO_SCALE_MIN=0.8
AUTO_SCALE_MAX=1.1
AUTO_CAPTURE_HOLD_FRAMES=10

# LLM chat config (for /api/chat)
# Supported providers: openai | gemini | local. Existing installations keep their value.
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Jetson B general LLM (OpenAI-compatible Chat Completions)
# Base URL includes exactly /v1. Register the exact origin in AI_ALLOWED_ENDPOINTS.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# Alternative to LOCAL_LLM_API_KEY: absolute path to an owned mode-0600 file.
LOCAL_LLM_API_KEY_FILE=
LOCAL_LLM_CONNECT_TIMEOUT=3
LOCAL_LLM_READ_TIMEOUT=90
LOCAL_LLM_REQUEST_DEADLINE=120
LOCAL_LLM_MAX_TOKENS=512
LOCAL_LLM_MAX_INFLIGHT=1
AI_ALLOWED_ENDPOINTS=

# Jetson A -> Jetson B headless management. Defaults are fail-closed.
# Remote plain HTTP is rejected; use verified HTTPS or an approved loopback tunnel.
AI_CONTROL_ENABLED=0
AI_CONTROL_DRAFTS_ENABLED=0
AI_CONTROL_MUTATIONS_ENABLED=0
AI_CONTROL_NODE_ID=jetson-b
AI_CONTROL_BASE_URL=
AI_CONTROL_ALLOWED_ORIGINS=
AI_CONTROL_API_KEY_FILE=
AI_CONTROL_CA_FILE=
AI_CONTROL_CONNECT_TIMEOUT=2
AI_CONTROL_READ_TIMEOUT=3
AI_CONTROL_REQUEST_DEADLINE=5
AI_CONTROL_STATUS_CACHE_SECONDS=5
AI_CONTROL_STATUS_STALE_SECONDS=15
# Optional absolute private file. Default: ~/.config/mediflow-ai/local-chat-generation.json
LOCAL_LLM_GENERATION_CONFIG_FILE=

# Jetson B controller process only; do not add these to the browser or A model form.
AI_CONTROL_STATE_DIR=
AI_CONTROL_REGISTRY_FILE=
AI_CONTROL_PROJECT_ROOT=
AI_CONTROL_LLAMA_SERVER=
AI_CONTROL_LOCAL_LLM_PID_FILE=
AI_CONTROL_CHAT_ARTIFACT_ID=
AI_CONTROL_VLM_ARTIFACT_ID=

# C4 Jetson B maintenance settings. Leave unset until the separately approved
# managed-ingress migration; defaults preserve the current general-LLM port.
AI_DEVICE_LIFECYCLE_LOCK=
LOCAL_LLM_HOST=0.0.0.0
LOCAL_LLM_PORT=8080
MEDGEMMA_HOST=127.0.0.1
MEDGEMMA_PORT=8081
AI_INGRESS_STATE_DIR=
AI_INGRESS_RUNTIME_RECEIPT_FILE=
AI_INGRESS_CHAT_UPSTREAM_PORT=
AI_INGRESS_VLM_UPSTREAM_PORT=
AI_INGRESS_HOST=127.0.0.1
AI_INGRESS_PORT=8080
AI_INGRESS_RAW_BYPASS_VERIFIED=0

# Research VLM is independent and disabled by default.
VLM_ENABLED=0
AI_EXPERIMENTS_ENABLED=0
BASELINE_EXPERIMENTS_ENABLED=0
EXPLANATION_EXPERIMENTS_ENABLED=0
SURVEY_VLM_EXPERIMENTS_ENABLED=0
HYBRID_REVIEW_EXPERIMENTS_ENABLED=0
AI_EXPERIMENT_MODE=shadow
AI_EXPERIMENT_AUTO_ENQUEUE=0
AI_DEPLOYMENT_PROFILE=chat_only
VLM_BACKEND=
VLM_BASE_URL=
VLM_MODEL=google/medgemma-1.5-4b-it
VLM_API_KEY=
VLM_CONNECT_TIMEOUT=3
VLM_READ_TIMEOUT=120
VLM_REQUEST_DEADLINE=180
VLM_MAX_NEW_TOKENS=512
VLM_MAX_INFLIGHT=1
EXPERIMENT_DATA_DIR=
EXPERIMENT_QUEUE_MAX=16
EXPERIMENT_STORE_RAW_OUTPUT=0
EXPERIMENT_ALLOW_REAL_DATA=0
# When enabled, each admin import still requires permission/retention refs and expiry.
GRADCAM_MODE=always

# Optional Kakao report bridge
KAKAO_APP_HOST=0.0.0.0
KAKAO_APP_PORT=5001
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_REFRESH_TOKEN=
KAKAO_ACCESS_TOKEN=
KAKAO_BRIDGE_URL=http://127.0.0.1:5001

# Optional public/LAN URL override used only for links displayed to users.
EXTERNAL_BASE_URL=
